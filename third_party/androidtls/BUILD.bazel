# Android TLS native bundle (specs/004 research.md D1/D2).
#
# Single genrule cross-builds the pinned OpenSSL 3.0.13 + libcurl 8.7.1
# static libraries for arm64-v8a and exports:
#   * libcrypto.a / libssl.a / libcurl.a — link inputs for cpp_network's engine
#   * include/curl/*.h                    — the exact public curl headers
#
# Consumers never reference OpenSSL headers (FR-016/FR-013): cpp_network compiles
# against curl/curl.h only. Host configs are unaffected; the genrule is
# android-only via target_compatible_with and only selected by src/http under
# //platforms:android_arm64_setting.
package(default_visibility = ["//visibility:public"])

# Public curl headers of the pinned release (curl-8_7_1/include/curl).
# Update this list together with the version pin in cpp_network_deps.bzl.
_CURL_PUBLIC_HEADERS = [
    "include/curl/curl.h",
    "include/curl/curlver.h",
    "include/curl/easy.h",
    "include/curl/header.h",
    "include/curl/mprintf.h",
    "include/curl/multi.h",
    "include/curl/options.h",
    "include/curl/stdcheaders.h",
    "include/curl/system.h",
    "include/curl/typecheck-gcc.h",
    "include/curl/urlapi.h",
    "include/curl/websockets.h",
]

genrule(
    name = "build_tls",
    srcs = [
        "@openssl//:sources",
        "@openssl//:root_entrypoint",
        "@curl//:sources",
        "@curl//:root_entrypoint",
        "//third_party/scripts:build-android-tls.sh",
    ],
    outs = [
        "lib/libcrypto.a",
        "lib/libssl.a",
        "lib/libcurl.a",
    ] + _CURL_PUBLIC_HEADERS,
    cmd = """
set -e

SCRIPT=$(location //third_party/scripts:build-android-tls.sh)
OPENSSL_SRC_DIR=$$(dirname $(location @openssl//:root_entrypoint))
CURL_SRC_DIR=$$(dirname $(location @curl//:root_entrypoint))


bash $$SCRIPT "$$OPENSSL_SRC_DIR" "$$CURL_SRC_DIR" "$$PWD/tls-install"

mkdir -p "$(RULEDIR)/lib" "$(RULEDIR)/include/curl"
cp tls-install/lib/libcrypto.a "$(RULEDIR)/lib/libcrypto.a"
cp tls-install/lib/libssl.a "$(RULEDIR)/lib/libssl.a"
cp tls-install/lib/libcurl.a "$(RULEDIR)/lib/libcurl.a"
""" + "\n".join([
        'cp "tls-install/%s" "$(RULEDIR)/%s"' % (hdr, hdr)
        for hdr in _CURL_PUBLIC_HEADERS
    ]),
    message = "cross-building OpenSSL+libcurl for android_arm64",
    tags = ["local", "manual"],
    target_compatible_with = ["@platforms//os:android"],
)

cc_library(
    name = "android_curl",
    srcs = [
        "lib/libcurl.a",
        "lib/libssl.a",
        "lib/libcrypto.a",
    ],
    hdrs = _CURL_PUBLIC_HEADERS,
    strip_include_prefix = "include",
    target_compatible_with = ["@platforms//os:android"],
)
