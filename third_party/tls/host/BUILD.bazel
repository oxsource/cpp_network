# Native-host TLS bundle (specs/005 US1): builds pinned OpenSSL 3.0.13 +
# libcurl 8.7.1 with the machine's own toolchain and object-level symbol
# hiding. Compatible with macOS and Linux host configs.
#
# ARCH NOTE: artifacts match the EXECUTING machine's architecture by design —
# build each host platform on that platform itself (or CI of the same arch).
package(default_visibility = ["//visibility:public"])

load("//third_party/tls:tls_headers.bzl", "CURL_PUBLIC_HEADERS", "OPENSSL_PUBLIC_HEADERS")

genrule(
    name = "build_tls",
    srcs = [
        "@openssl//:sources",
        "@openssl//:root_entrypoint",
        "@curl//:sources",
        "@curl//:root_entrypoint",
        "//third_party/scripts:build-tls.sh",
    ],
    outs = [
        "lib/libcrypto.a",
        "lib/libssl.a",
        "lib/libcurl.a",
    ] + CURL_PUBLIC_HEADERS + OPENSSL_PUBLIC_HEADERS,
    cmd = """
set -e

SCRIPT=$(location //third_party/scripts:build-tls.sh)
OPENSSL_SRC_DIR=$$(dirname $(location @openssl//:root_entrypoint))
CURL_SRC_DIR=$$(dirname $(location @curl//:root_entrypoint))

bash $$SCRIPT host "$$OPENSSL_SRC_DIR" "$$CURL_SRC_DIR" "$$PWD/tls-install"

mkdir -p "$(RULEDIR)/lib" "$(RULEDIR)/include/curl" "$(RULEDIR)/include/openssl"
cp tls-install/lib/libcrypto.a "$(RULEDIR)/lib/libcrypto.a"
cp tls-install/lib/libssl.a "$(RULEDIR)/lib/libssl.a"
cp tls-install/lib/libcurl.a "$(RULEDIR)/lib/libcurl.a"
""" + "\n".join([
        'cp "tls-install/%s" "$(RULEDIR)/%s"' % (hdr, hdr)
        for hdr in CURL_PUBLIC_HEADERS + OPENSSL_PUBLIC_HEADERS
    ]),
    message = "building OpenSSL+libcurl for the native host",
    tags = ["local", "manual"],
)

cc_library(
    name = "curl",
    srcs = [
        "lib/libcurl.a",
        "lib/libssl.a",
        "lib/libcrypto.a",
    ],
    hdrs = CURL_PUBLIC_HEADERS,
    strip_include_prefix = "include",
    # macOS builds compile lib/macos.c (CURL_MACOS_CALL_COPYPROXIES): it
    # requires these two system frameworks at final-link time. Applied
    # unconditionally here because the target is only analyzed for macOS/Linux
    # host configs.
    linkopts = select({
        "//platforms:macos_arm64_setting": [
            "-framework CoreFoundation",
            "-framework SystemConfiguration",
        ],
        "//platforms:macos_x86_64_setting": [
            "-framework CoreFoundation",
            "-framework SystemConfiguration",
        ],
        "//conditions:default": [],
    }),
)

# Reusable OpenSSL slice of the TLS bundle: same genrule outputs, exposed so
# external consumers that only need OpenSSL (e.g. libdatachannel's DTLS) link
# the bundle instead of building their own OpenSSL copy.
cc_library(
    name = "openssl",
    srcs = [
        "lib/libssl.a",
        "lib/libcrypto.a",
    ],
    hdrs = OPENSSL_PUBLIC_HEADERS,
    strip_include_prefix = "include",
)
