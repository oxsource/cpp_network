# Android arm64-v8a TLS bundle (specs/004 semantics preserved; driver
# generalized in specs/005 T001). Cross-built from pinned sources via the NDK;
# outputs feed src/http on --config=android_arm64 only.
package(default_visibility = ["//visibility:public"])

_CURL_PUBLIC_HEADERS = [
    "include/curl/curl.h",
    "include/curl/curlver.h",
    "include/curl/easy.h",
    "include/curl/header.h",
    "include/curl/mprintf.h",
    "include/curl/multi.h",
    "include/curl/options.h",
    "include/curl/stdcheaders.h",
    "include/curl/system.h",
    "include/curl/typecheck-gcc.h",
    "include/curl/urlapi.h",
    "include/curl/websockets.h",
]

genrule(
    name = "build_tls",
    srcs = [
        "@openssl//:sources",
        "@openssl//:root_entrypoint",
        "@curl//:sources",
        "@curl//:root_entrypoint",
        "//third_party/scripts:build-tls.sh",
    ],
    outs = [
        "lib/libcrypto.a",
        "lib/libssl.a",
        "lib/libcurl.a",
    ] + _CURL_PUBLIC_HEADERS,
    cmd = """
set -e

SCRIPT=$(location //third_party/scripts:build-tls.sh)
OPENSSL_SRC_DIR=$$(dirname $(location @openssl//:root_entrypoint))
CURL_SRC_DIR=$$(dirname $(location @curl//:root_entrypoint))

bash $$SCRIPT android "$$OPENSSL_SRC_DIR" "$$CURL_SRC_DIR" "$$PWD/tls-install"

mkdir -p "$(RULEDIR)/lib" "$(RULEDIR)/include/curl"
cp tls-install/lib/libcrypto.a "$(RULEDIR)/lib/libcrypto.a"
cp tls-install/lib/libssl.a "$(RULEDIR)/lib/libssl.a"
cp tls-install/lib/libcurl.a "$(RULEDIR)/lib/libcurl.a"
""" + "\n".join([
        'cp "tls-install/%s" "$(RULEDIR)/%s"' % (hdr, hdr)
        for hdr in _CURL_PUBLIC_HEADERS
    ]),
    message = "cross-building OpenSSL+libcurl for android_arm64",
    tags = ["local", "manual"],
    target_compatible_with = ["@platforms//os:android"],
)

cc_library(
    name = "curl",
    srcs = [
        "lib/libcurl.a",
        "lib/libssl.a",
        "lib/libcrypto.a",
    ],
    hdrs = _CURL_PUBLIC_HEADERS,
    strip_include_prefix = "include",
    target_compatible_with = ["@platforms//os:android"],
)
