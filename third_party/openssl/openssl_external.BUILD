# @openssl injected file list (specs/005): consumed by the unified
# third_party/scripts/build-tls.sh driver via third_party/tls/{android,host}.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["**"]),
)

filegroup(
    name = "root_entrypoint",
    srcs = ["README.md"],
)
