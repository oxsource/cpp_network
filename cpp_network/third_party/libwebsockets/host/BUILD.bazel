genrule(
    name = "build_lws",
    srcs = [
        "@lws//:sources",
        "@lws//:root_entrypoint",
        "//third_party/scripts:build_libwebsockets.sh",
        "//third_party/openssl/host:bundle_tar",
    ],
    outs = ["lib/libwebsockets.a"] + LWS_PUBLIC_HEADERS,
    cmd = """
set -e

SCRIPT=$(location //third_party/scripts:build_libwebsockets.sh)
TAR_BUNDLE=$(location //third_party/openssl/host:bundle_tar)

# Normalize the declared-output area (stale 0444 files would EPERM reruns).
rm -rf "$(RULEDIR)/include" "$(RULEDIR)/lib"

# Stage inputs the driver expects.
mkdir -p "$$PWD/work" "$$PWD/work/openssl-root"
tar -xzf "$$TAR_BUNDLE" -C "$$PWD/work/openssl-root"
cp -R $$(dirname $(location @lws//:root_entrypoint))/. "$$PWD/work/lws/"

# Build lws against the staged OpenSSL tree; install straight into the
# declared output directory (no intermediate copies).
bash $$SCRIPT host "$$PWD/work/openssl-root" "$(RULEDIR)"
""",

    message = "building libwebsockets for the native host",
    tags = ["local", "manual"],
)

cc_library(
    name = "websockets",
    srcs = [
        "lib/libwebsockets.a",
    ],
    hdrs = LWS_PUBLIC_HEADERS,
    strip_include_prefix = "include",
    # libwebsockets.h re-includes <openssl/*.h> (libwebsockets D3: single
    # TLS stack), so the OpenSSL slice of the TLS bundle must ride along.
    deps = ["//third_party/openssl/host:openssl"],
)
