# Native-host libwebsockets bundle (specs/006 research.md D2/T004): CMake-
# builds pinned lws 4.5.8 against the native TLS bundle's OpenSSL install
# tree, producing a static client-only archive. Arch note identical to
# third_party/openssl/host: artifacts match the EXECUTING machine.
package(default_visibility = ["//visibility:public"])

# Installed public headers verified from the Phase-1 smoke build layout:
# include/libwebsockets/* + top-level umbrella/generated headers.
LWS_PUBLIC_HEADERS = [
