# Nested workspace (external-consumption demo): excluded so that `//...`
# never traverses its generated symlinks (bazel-*) which loop back into this
# repository. Build it separately: cd sample/consumer_demo && bazel build ...
sample/consumer_demo

# Manual scratch trees from Phase 1 dev (lws/curl/openssl extraction). The
# lws tarball ships self-referential symlinks (minimal-examples/embedded/*)
# that loop back to the tree root; excluded so `//...` package discovery
# never expands them. Regenerable, delete freely: rm -rf work
work
