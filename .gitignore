# work/: 直接运行 cpp_network/third_party/scripts/build-tls.sh 调试时的现场
# （已 Configure 的 openssl/curl 源码树副本），保留以便后续验证复用；
# make/genrule 正式构建在 bazel 沙箱内进行，不依赖也不清理它。
/cpp_network/work/

# Python bytecode artifacts from test fixtures
__pycache__/
*.pyc
