# Machine-local overrides (generated by tools/platform_setup.sh, git-ignored).
# NOTE: kept FIRST so that later `--config=<platform>` aliases below win flag
# precedence — otherwise an explicit `--config=android_arm64` would be
# silently overridden back to the host platform (specs/004 T005 finding).
try-import %workspace%/.user.bazelrc

# C++ standard
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Platform auto-detection: NO --enable_platform_specific_config here — that
# flag re-applies the host platform section AFTER command-line configs,
# silently overriding any explicit cross-config (e.g. --config=android_arm64).
# The host platform instead comes from .user.bazelrc (tools/platform_setup.sh),
# mirroring the verified video_codec workspace where cross-builds pass an
# explicit --config and no forced default --platforms exists.

# Local caches (outside the output base so they survive `bazel clean`),
# mirroring the verified video_codec workspace: source archives and
# configure/make outputs are restored instead of re-downloaded/rebuilt.
common --disk_cache=~/.cache/bazel/disk
common --repository_cache=~/.cache/bazel/repository

# Test output
build --test_output=errors

# Platform aliases (mirror graph_runtime conventions)
build:macos_arm64   --platforms=//platforms:macos_arm64
build:macos_x86_64  --platforms=//platforms:macos_x86_64
build:linux_x86_64  --platforms=//platforms:linux_x86_64
build:linux_aarch64 --platforms=//platforms:linux_aarch64
build:android_arm64 --platforms=//platforms:android_arm64

# Android NDK cc_toolchain (specs/004): registered only under the android
# config, so host builds never fetch @androidndk and stay NDK-free (FR-010).
# Requires ANDROID_NDK_HOME pointing at NDK r26+; see tools/platform_setup.sh.
build:android_arm64 --extra_toolchains=@androidndk//:all
build:android_arm64 --incompatible_enable_cc_toolchain_resolution=true
# Pass the client NDK root into cross-build actions (third_party/androidtls).
build:android_arm64 --action_env=ANDROID_NDK_HOME
