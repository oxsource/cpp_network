# Unit and integration tests for the cpp_network library.
package(default_visibility = ["//visibility:public"])

cc_test(
    name = "smoke_test",
    srcs = ["smoke_test.cc"],
    deps = [
        "@cpp_network//src/public:cpp_network",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Device/host e2e checker for specs/004 US1: same binary runs on the host
# against local fixtures and on Android via make push/run, where the cert
# root comes from NETLIB_TEST_DATA_DIR and services arrive via adb reverse.
cc_binary(
    name = "device_e2e",
    srcs = [
        "device_e2e.cc",
        "test_util.h",
    ],
    deps = [
        "@cpp_network//src/http:client",
        "@cpp_network//src/public:public_headers",
    ],
)

cc_test(
    name = "http_integration_test",
    srcs = ["http_integration_test.cc"],
    data = ["test_server.py"],
    deps = [
        "@cpp_network//src/http:client",
        "@cpp_network//src/public:public_headers",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "https_test",
