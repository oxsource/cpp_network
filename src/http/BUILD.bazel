# HTTP implementation for the cpp_network library (synchronous API over libcurl).
# Public type definitions live in //src/public:public_headers; this package
# provides the implementation translation units. TLS validation lives in
# //src/tls:tls; CURLOPT_SSL_* mapping is applied here per-request.
package(default_visibility = [
    "@cpp_network//src/public:__pkg__",
    "@cpp_network//src/tests:__pkg__",
])

PUBLIC_HEADERS = "@cpp_network//src/public:public_headers"
cc_library(
    name = "error",
    srcs = ["error.cc"],
    deps = [PUBLIC_HEADERS],
)

cc_library(
    name = "result",
    deps = [
        PUBLIC_HEADERS,
        ":error",
    ],
)

cc_library(
    name = "method",
    deps = [PUBLIC_HEADERS],
)

cc_library(
    name = "request",
    srcs = ["request.cc"],
    deps = [
        PUBLIC_HEADERS,
        ":error",
        ":method",
        ":result",
    ],
)

cc_library(
    name = "response",
    srcs = ["response_stream.cc"],
    deps = [
        PUBLIC_HEADERS,
        ":error",
        ":result",
    ],
)

cc_library(
    name = "options",
    srcs = ["options.cc"],
    deps = [
        PUBLIC_HEADERS,
        ":error",
        ":result",
        "//src/tls:tls",
    ],
)

cc_library(
    name = "engine",
    srcs = ["engine.cc", "detail/curl_mapping.cc"],
    hdrs = ["engine.h", "detail/curl_mapping.h"],
    deps = [
        PUBLIC_HEADERS,
        ":error",
        ":method",
        ":options",
        ":request",
        ":response",
        ":result",
        "//src/tls:tls",
    ],
    linkopts = ["-lcurl"],
)

cc_library(
    name = "client",
    srcs = ["client.cc"],
    deps = [
        PUBLIC_HEADERS,
        ":engine",
        ":error",
        ":method",
        ":options",
        ":request",
        ":response",
        ":result",
        "//src/tls:tls",
    ],
    linkopts = ["-lcurl"],
)
