# TLS configuration layer for the netlib library.
#
# The `tls` target provides Tls validation (CA sources, mTLS pairing, SNI,
# inline PEM sanity). CURLOPT_SSL_* mapping lives in //src/http:engine
# (detail/curl_mapping.cc) since it is applied per-request by the transport
# engine. OpenSSL (3.x LTS) is the TLS backend on ALL platforms (host
# macOS/Linux and Android), reached through libcurl's TLS backend.
package(default_visibility = [
    "//src/http:__pkg__",
    "@cpp_network//src/tests:__pkg__",
])

PUBLIC_HEADERS = "@cpp_network//src/public:public_headers"

# Error/Result types are header-only; only the public headers are needed.
cc_library(
    name = "tls",
    srcs = ["tls.cc"],
    deps = [PUBLIC_HEADERS],
)
